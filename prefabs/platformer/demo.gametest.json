  "stop_on_error": true,
  "chunks": {
    "enter": {
      "gml": "room_goto(rm_level);"
    },
    "init": {
      "gml": "global.gt_seen=false; global.gt_ground=false; global.gt_x=0; global.gt_y=0; global.gt_enemies = instance_number(obj_enemy); global.gt_min = global.gt_enemies;"
    },
    "watch": {
      "gml": "if (instance_exists(obj_player)) { global.gt_seen = true; if (obj_player.jump.on_ground) global.gt_ground = true; global.gt_y = max(global.gt_y, obj_player.y); global.gt_x = max(global.gt_x, obj_player.x); } global.gt_min = min(global.gt_min, instance_number(obj_enemy));"
    },
    "seen": {
      "gml": "return global.gt_seen;"
    },
    "grounded": {
      "gml": "return global.gt_ground;"
    },
    "in_world": {
      "gml": "return global.gt_y < room_height;"
    },
    "moved_right": {
      "gml": "return global.gt_x > 112;"
    },
    "patrols_kept": {
      "gml": "return global.gt_min >= global.gt_enemies;"
    }
  },
